# ===== Moomoo / OpenD =====
# OpenD 本地网关地址。OpenD 内部自行登录，后端只需 host + port。
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# 预留字段：仅用于未来配置 OpenD 登录，不传给 SDK。
MOOMOO_PASSWORD=

# ===== AI（OpenAI 兼容端点）=====
# 可用 OpenAI / DeepSeek / Moonshot 等任何 OpenAI 兼容服务。
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== 存储 =====
# 本地零依赖：SQLite（默认）。生产/Docker 换成 Postgres，例如
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/market_intel
DATABASE_URL=sqlite:///./market_intel.db
REDIS_URL=redis://localhost:6379/0

# ===== 资讯（Moomoo 公开端点，免 Key）=====
NEWS_BASE_URL=https://ai-news-search.futunn.com
NEWS_LANG=en
NEWS_SIZE=20
