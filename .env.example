# Copy to `.env` and adjust before `docker compose up`.
# OpenD runs on the HOST machine; from inside a container reach it at
# host.docker.internal (default). Leave as-is if you aren't using OpenD —
# the app auto-falls back to yfinance for market data.

MOOMOO_HOST=host.docker.internal
MOOMOO_PORT=11111

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

NEWS_BASE_URL=https://ai-news-search.futunn.com
NEWS_LANG=en
NEWS_SIZE=20

REDIS_URL=redis://redis:6379/0
